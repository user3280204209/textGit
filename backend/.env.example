# ============================================================
# 环境变量模板
# ============================================================
# 用法：
#   1. 复制本文件为 .env          →  cp .env.example .env
#   2. 把 LLM_API_KEY 换成真实 Key
#   3. 绝不把 .env 提交到 Git（已在 .gitignore 中屏蔽）
#
# ⚠️ 全组约定：默认统一用 DeepSeek，避免每人用不同模型导致
#    生成效果不一致、排查困难。换模型请先在群里同步。
# ============================================================

# ---- 基础 ----
ENV=dev
DEBUG=true

# ---- LLM（OpenAI 兼容协议）----
# DeepSeek:  https://platform.deepseek.com      base_url=https://api.deepseek.com/v1
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1   model=qwen-plus
# OpenAI:    https://api.openai.com/v1          model=gpt-4o-mini
LLM_API_KEY=sk-在这里填你的真实Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ---- Embedding（远程 API，避免本地 torch 依赖）----
# 留空则"精准推送"退化为关键词匹配，功能仍可用
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ---- 多模态生成（可选；不填则视频类资源自动降级为脚本+动画方案）----
IMAGE_API_KEY=
IMAGE_API_BASE_URL=
VIDEO_API_KEY=
VIDEO_API_BASE_URL=

# ---- 数据库 ----
# 开发期用 SQLite，答辩部署时换成：
# postgresql+asyncpg://user:pass@localhost:5432/learnagent
DATABASE_URL=sqlite+aiosqlite:///./storage/learnagent.db

# ---- 前端联调（CORS 白名单，逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 生成任务参数 ----
MAX_CONCURRENT_AGENTS=4
AGENT_TIMEOUT_SECONDS=180
STORAGE_DIR=./storage
